# SECURITY CONFIGURATION EXAMPLE
# Copy this file to your .env.local and fill in the actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bot Protection (Cloudflare Turnstile)
# Get these from https://www.cloudflare.com/products/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Rate Limiting (Redis - for production)
# Uncomment and configure for production deployments
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# IP Intelligence (optional - for enhanced bot detection)
# Get API key from https://www.ipintel.io/
# IPINTEL_API_KEY=your_ipintel_api_key

# Security Monitoring (optional)
# SECURITY_WEBHOOK_URL=https://your-monitoring-service.com/webhook
# SECURITY_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Security Configuration Overrides
# These are optional - sensible defaults are provided in the code

# Rate limiting settings
# RATE_LIMIT_WINDOW_MS=60000  # 1 minute window
# RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Bot protection settings
# BOT_PROTECTION_ENABLED=true
# HONEYPOT_ENABLED=true

# Development Settings
# NEXT_PUBLIC_DEBUG_MODE=false
NODE_ENV=development
ENV=dev

# Note: Never commit actual secret values to version control!
# Use environment-specific .env files for different deployments
