{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../memory-bank/scripts/detect-changes.js --auto",
    "dev": "concurrently --names \"NEXT,STRIPE,NGROK\" --prefix-colors \"blue,yellow,magenta\" \"next dev --port 3000\" \"stripe listen --forward-to localhost:3000/api/payment/webhook\" \"node ../scripts/dev-ngrok.cjs\"",
    "dev:no-stripe": "next dev --port 3000",
    "dev:no-types": "next dev --port 3000",
    "build": "next build",
    "build:no-types": "next build",
    "start": "next start",
    "lint": "next lint",
    "configure-s3-cors": "npx tsx src/scripts/configure-s3-cors.ts",
    "generate-types": "npx tsx --tsconfig tsconfig.scripts.json src/scripts/generate-types.ts",
    "detect-changes": "node ../memory-bank/scripts/detect-changes.js"
  },
