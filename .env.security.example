# Security Configuration for Primeshot
# Copy this file to .env.local and fill in the required values

# Redis for distributed rate limiting (required for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CAPTCHA Services (choose one)
# Cloudflare Turnstile (Recommended)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Alternative: Google reCAPTCHA
# RECAPTCHA_SECRET_KEY=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Security Monitoring & Alerting
# DataDog (for security monitoring)
DATADOG_API_KEY=
DATADOG_APP_KEY=

# Sentry (for error monitoring)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Security Monitoring Webhook (for custom monitoring)
SECURITY_MONITORING_URL=

# DDoS Protection & CDN
# Cloudflare (for edge-level protection)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Additional security headers
SECURITY_HEADERS=true

# Rate limiting configuration (these are defaults, can be overridden)
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_INFERENCE_WINDOW_MS=60000
RATE_LIMIT_INFERENCE_MAX_REQUESTS=20

# Bot detection sensitivity (0-100, higher = more strict)
BOT_DETECTION_THRESHOLD=50

# Security logging level (debug, info, warn, error)
SECURITY_LOG_LEVEL=info
