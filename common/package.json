{
  "name": "@primeshot/common",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const path=require('path');const src=path.resolve('web');const dst=path.resolve('dist','web');(function copy(p,q){fs.mkdirSync(q,{recursive:true});for(const e of fs.readdirSync(p,{withFileTypes:true})){const sp=path.join(p,e.name);const dq=path.join(q,e.name);if(e.isDirectory()){copy(sp,dq)}else if(e.isFile()&&e.name.endsWith('.css')){fs.mkdirSync(path.dirname(dq),{recursive:true});fs.copyFileSync(sp,dq)}}})(src,dst);console.log('[common] Copied CSS to dist/web');\"",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "dotenv": "^17.0.1",
    "stripe": "^18.3.0",
    "archiver": "^6.0.2",
    "embla-carousel-react": "^8.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*": {
      "default": "./dist/locales/*"
    },
    "./locales/en/*": {
      "default": "./dist/locales/en/*"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./lib/stripe/*": {
      "types": "./dist/lib/stripe/*.d.ts",
      "default": "./dist/lib/stripe/*.js"
    },
    "./web/*": {
      "types": "./dist/web/*.d.ts",
      "default": "./dist/web/*.js"
    }
  }
} 