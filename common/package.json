{
  "name": "@primeshot/common",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "watch:assets": "chokidar \"web/**/*.css\" \"locales/**/*.json\" -c \"node scripts/postbuild.mjs\"",
    "dev": "concurrently -k \"npm:watch\" \"npm:watch:assets\""
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "dotenv": "^17.0.1",
    "embla-carousel-react": "^8.6.0",
    "stripe": "^18.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=15"
  },
  "devDependencies": {
    "chokidar-cli": "3.0.0",
    "concurrently": "9.2.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*": {
      "default": "./dist/locales/*"
    },
    "./locales/en/*": {
      "default": "./dist/locales/en/*"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./lib/stripe/*": {
      "types": "./dist/lib/stripe/*.d.ts",
      "default": "./dist/lib/stripe/*.js"
    },
    "./web/*": {
      "types": "./dist/web/*.d.ts",
      "default": "./dist/web/*.js"
    }
  }
}
