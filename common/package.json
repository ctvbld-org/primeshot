{
  "name": "@primeshot/common",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "dotenv": "^17.0.1",
    "stripe": "^18.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=15"
  },
  "exports": {
    "./hooks/*": "./hooks/*", 
    "./lib/*": "./lib/*", 
    "./lib/stripe/*": "./lib/stripe/*",
    "./web/*": "./web/*",
    "./hooks": "./hooks/index.ts",
    "./lib": "./lib/index.ts",
    "./web": "./web/index.ts",
    ".": "./index.ts"
  }
} 