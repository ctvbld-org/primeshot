```
/
├── .cursor/         # Cursor IDE configuration and rules
├── .git/            # Git repository data
├── webapp/          # Main SPA Next.js application (Next.js)
├── website/         # Marketing site (Next.js, mostly static)
├── common/          # Shared package published as @primeshot/common (components, hooks, utils, shared locales)
├── ai-container/    # Modal containers for training and inference
│   ├── ai-toolkit-modal/      # Training LoRA project container on Modal
│   └── comfyui-modal/         # ComfyUI project container for inference on Modal
├── scripts/         # Development and utility scripts
